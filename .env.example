# PolicyGuard AI - Example environment variables (backend)
# Do NOT store real secrets here. Copy to backend/.env and fill in values.

# ------------------------------------------------------------------
# SECURITY (required in production - the backend refuses to start
# without these when APP_ENV=production)
# ------------------------------------------------------------------

# Session token signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
POLICYGUARD_AUTH_SECRET=

# Officer demo password (seeds the officer-001 account for the SIH demo).
# Set a strong value in production; development falls back to officer123.
POLICYGUARD_DEMO_PASSWORD=

# Comma-separated list of allowed browser origins for CORS.
# Production example: https://policyguardai.vercel.app
# Wildcard (*) is refused in production.
POLICYGUARD_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------

# development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Storage for uploaded documents, analysis and audit data (JSON file store).
STORAGE_PATH=./storage

# ------------------------------------------------------------------
# OPTIONAL INTEGRATION POINTS (not required for the current build)
# ------------------------------------------------------------------

# Database (the current build uses file-backed storage; reserved for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/policyguard

# Vector DB (qdrant or pgvector; the current build uses the local vector store)
# VECTOR_DB_URL=http://localhost:6333

# AI provider (openai, local, etc.) - reserved for future embedding providers
# AI_PROVIDER=openai
# AI_API_KEY=

# ------------------------------------------------------------------
# OCR (scanned-PDF support)
# ------------------------------------------------------------------

# Tesseract binary path. Usually auto-discovered; set explicitly if needed.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=eng
# TESSERACT_PSM=6
# TESSERACT_OEM=3
