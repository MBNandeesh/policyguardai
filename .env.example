# PolicyGuard AI - Example environment variables
# Do NOT store real secrets here. Copy to .env and fill in values.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/policyguard

# Vector DB (qdrant or pgvector)
VECTOR_DB_URL=http://localhost:6333

# AI provider (openai, local, etc.)
AI_PROVIDER=openai
AI_API_KEY=

# Storage for uploaded documents
STORAGE_PATH=./storage

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
