# Frontend Environment Variables
# Copy to .env.local and update with your backend URL

# Server-side URL used by the Next.js /api/v1 proxy. This avoids browser CORS
# requirements when the frontend and FastAPI service use different ports.
BACKEND_API_URL=http://localhost:8000

# Optional public API override; use only if that API accepts browser CORS requests.
# NEXT_PUBLIC_API_URL=https://api.example.gov/api/v1

# Optional: Add other configuration as needed
# NEXT_PUBLIC_APP_NAME=PolicyGuard AI
# NEXT_PUBLIC_ENVIRONMENT=development
